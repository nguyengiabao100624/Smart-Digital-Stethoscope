PORT=3000
AUDIO_UDP_PORT=3001
SAMPLE_RATE=16000
DATA_DIR=/data
CORS_ORIGIN=https://admin.smart-health.example.com
RATE_LIMIT_PER_MINUTE=300
MAX_JSON_BODY_BYTES=65536
# Number of trusted reverse-proxy hops. Keep 0 for direct access; set only when
# the ingress normalizes X-Forwarded-For before forwarding to this backend.
TRUST_PROXY_HOPS=0

# Runtime data store. Use json for quick demo, postgres for production/dev stack.
DATA_BACKEND=postgres
DATABASE_URL=postgresql://smart_health:smart_health_dev@postgres:5432/smart_health
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=smart-health-audio
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=smarthealth
S3_SECRET_ACCESS_KEY=smarthealth_dev_secret

# Auth production placeholders
AUTH_MODE=production
ALLOW_DEMO_AUTH=false
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=smart-health-demo
FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Current-password proof uses Firebase Identity Toolkit, then verifies the
# returned ID token with the configured Admin SDK before any password mutation.
FIREBASE_PASSWORD_VERIFY_TIMEOUT_MS=8000
FIREBASE_PASSWORD_PROOF_TTL_MS=60000

# Public HTTPS backend URLs used by Web Admin, Android, ESP cloud OTA, and readiness checks.
PUBLIC_BACKEND_URL=https://api.smart-health.example.com
SMART_HEALTH_PUBLIC_URL=https://api.smart-health.example.com
PUBLIC_API_BASE_URL=https://api.smart-health.example.com/api/v1
WEB_ADMIN_URL=https://shcare-admin.web.app

# PHI/data protection. Generate a real 32-byte secret and store it in the hosting secret manager.
PHI_ENCRYPTION_KEY=
PHI_ENCRYPTION_KEY_VERSION=v1
# Optional dedicated HMAC key for password-change idempotency. If omitted, the
# backend derives a domain-separated key from PHI_ENCRYPTION_KEY. Minimum 32 bytes.
PASSWORD_IDEMPOTENCY_HMAC_KEY=

# Optional email channel. Render Free blocks SMTP ports, so use Brevo API over HTTPS first.
EMAIL_PROVIDER=brevo
NOTIFICATION_EMAIL_ENABLED=true
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@smart-health.example.com
BREVO_FROM_NAME=Smart Health
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# Optional SMTP fallback for paid hosts or local demos. Gmail requires 2-Step Verification and an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Health <no-reply@smart-health.example.com>"

# Optional SMS/Zalo bridge. The backend sends a signed webhook payload to your provider/relay.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=
# Workspace-managed destinations are rejected unless their exact HTTPS origin
# is approved here (comma-separated). A platform OUTBOUND_WEBHOOK_URL bypasses
# the tenant allowlist because only the operator controls that destination.
OUTBOUND_WEBHOOK_ALLOWED_ORIGINS=
OUTBOUND_WEBHOOK_TIMEOUT_MS=8000
OUTBOUND_WEBHOOK_MAX_RESPONSE_BYTES=16384

# Optional MQTT/TLS control plane. Current backend can use device WebSocket without MQTT.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-health-backend
OTA_EXECUTION_TTL_MS=7200000
