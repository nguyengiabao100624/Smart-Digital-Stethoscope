{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shcare.vn/contracts/device/v2/audio-frame-header.schema.json",
  "title": "Shcare protocol v2 audio frame header",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "workspaceId",
    "patientId",
    "deviceId",
    "scanId",
    "sessionId",
    "sequence",
    "timestampMs",
    "sampleRate",
    "sampleCount",
    "encoding",
    "flags"
  ],
  "properties": {
    "protocolVersion": { "const": 2 },
    "workspaceId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "patientId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "deviceId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "scanId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "timestampMs": { "type": "integer", "minimum": 0 },
    "sampleRate": { "const": 16000 },
    "sampleCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "encoding": { "const": "pcm_s16le" },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["start", "end", "discontinuity", "retransmit"] }
    }
  }
}
