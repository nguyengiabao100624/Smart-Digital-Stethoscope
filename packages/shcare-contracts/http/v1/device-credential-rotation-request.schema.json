{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shcare.vn/http/v1/device-credential-rotation-request.schema.json",
  "title": "Shcare backend-generated device credential rotation request",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 0,
  "x-shcare-http": {
    "method": "POST",
    "path": "/v1/devices/{deviceId}/rotate-secret",
    "requiredHeaders": ["Idempotency-Key"]
  },
  "x-shcare-credential-policy": {
    "candidateSource": "backend-generated",
    "operatorCredentialInput": "forbidden",
    "confirmationAuthority": "authenticated-device-reconnect"
  }
}
