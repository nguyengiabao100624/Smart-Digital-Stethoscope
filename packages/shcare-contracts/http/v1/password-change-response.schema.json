{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shcare.vn/contracts/http/v1/password-change-response.schema.json",
  "title": "Shcare self-service password change receipt",
  "description": "Exact backend receipt returned only after the identity provider has confirmed the password mutation for the authenticated account. It never contains either password, a credential, token or provider claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "user",
    "provider",
    "operationId",
    "replayed"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      }
    },
    "provider": {
      "type": "string",
      "enum": [
        "firebase",
        "demo"
      ]
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
