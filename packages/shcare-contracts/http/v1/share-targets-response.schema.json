{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shcare.vn/contracts/http/v1/share-targets-response.schema.json",
  "title": "Shcare data-access target response",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "workspaceId", "doctors", "workspaces"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "doctors": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "workspaces": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    }
  }
}
