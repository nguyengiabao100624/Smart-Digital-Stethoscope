PORT=3000
AUDIO_UDP_PORT=3001
SAMPLE_RATE=16000
DATA_DIR=/data
CORS_ORIGIN=https://admin.smart-health.example.com
RATE_LIMIT_PER_MINUTE=300

# Runtime data store. Use json for quick demo, postgres for production/dev stack.
DATA_BACKEND=postgres
DATABASE_URL=postgresql://smart_health:smart_health_dev@postgres:5432/smart_health
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=smart-health-audio
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=smarthealth
S3_SECRET_ACCESS_KEY=smarthealth_dev_secret

# Auth production placeholders
AUTH_MODE=production
ALLOW_DEMO_AUTH=false
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=smart-health-demo
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# Public HTTPS backend URLs used by Web Admin, Android, ESP cloud OTA, and readiness checks.
PUBLIC_BACKEND_URL=https://api.smart-health.example.com
SMART_HEALTH_PUBLIC_URL=https://api.smart-health.example.com
PUBLIC_API_BASE_URL=https://api.smart-health.example.com/api/v1

# PHI/data protection. Generate a real 32-byte secret and store it in the hosting secret manager.
PHI_ENCRYPTION_KEY=

# Optional email channel. Gmail requires 2-Step Verification and an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Health <no-reply@smart-health.example.com>"

# Optional SMS/Zalo bridge. The backend sends a signed webhook payload to your provider/relay.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=

# Optional MQTT/TLS control plane. Current backend can use device WebSocket without MQTT.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-health-backend
