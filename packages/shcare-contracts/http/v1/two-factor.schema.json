{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.shcare.vn/http/v1/two-factor.schema.json",
  "title": "Shcare two-factor authentication responses",
  "oneOf": [
    { "$ref": "#/$defs/statusResponse" },
    { "$ref": "#/$defs/enrollmentResponse" },
    { "$ref": "#/$defs/verifiedResponse" },
    { "$ref": "#/$defs/recoveryAcknowledgedResponse" },
    { "$ref": "#/$defs/challengeRequiredError" },
    { "$ref": "#/$defs/challengeResponse" },
    { "$ref": "#/$defs/disabledResponse" }
  ],
  "$defs": {
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "status", "methods", "reason"],
      "properties": {
        "available": { "type": "boolean" },
        "status": { "enum": ["available", "unavailable"] },
        "methods": { "type": "array", "uniqueItems": true, "items": { "const": "app" } },
        "reason": { "type": "string", "maxLength": 160 }
      }
    },
    "twoFactorState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "method", "enrollmentPending"],
      "properties": {
        "enabled": { "type": "boolean" },
        "method": { "enum": ["", "app"] },
        "enrollmentPending": { "type": "boolean" }
      }
    },
    "twoFactorPendingState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "method", "enrollmentPending"],
      "properties": {
        "enabled": { "const": false },
        "method": { "const": "" },
        "enrollmentPending": { "const": true }
      }
    },
    "twoFactorEnabledState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "method", "enrollmentPending"],
      "properties": {
        "enabled": { "const": true },
        "method": { "const": "app" },
        "enrollmentPending": { "const": false }
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "manualKey", "otpauthUri", "expiresAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "method": { "const": "app" },
        "manualKey": { "type": "string", "pattern": "^[A-Z2-7]{16,128}$" },
        "otpauthUri": { "type": "string", "pattern": "^otpauth://totp/" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "statusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "twoFactor"],
      "properties": {
        "availability": { "$ref": "#/$defs/availability" },
        "twoFactor": { "$ref": "#/$defs/twoFactorState" }
      }
    },
    "enrollmentResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "twoFactor", "enrollment", "replayed", "superseded"],
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "twoFactor": { "$ref": "#/$defs/twoFactorPendingState" },
        "enrollment": { "$ref": "#/$defs/enrollment" },
        "replayed": { "type": "boolean" },
        "superseded": { "type": "boolean" }
      }
    },
    "verifiedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "enrollmentId", "twoFactor", "recoveryCodes", "recoveryDelivery", "recoveryAckToken", "replayed"],
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "enrollmentId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "twoFactor": { "$ref": "#/$defs/twoFactorPendingState" },
        "recoveryCodes": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-F0-9]{6}-[A-F0-9]{6}$" }
        },
        "recoveryDelivery": { "$ref": "#/$defs/recoveryDeliveryPending" },
        "recoveryAckToken": { "type": "string", "minLength": 32, "maxLength": 1024, "pattern": "^[A-Za-z0-9_-]+$" },
        "replayed": { "type": "boolean" }
      }
    },
    "recoveryDeliveryPending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expiresAt", "acknowledged"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "acknowledged": { "const": false }
      }
    },
    "recoveryDeliveryAcknowledged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expiresAt", "acknowledged", "acknowledgedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "acknowledged": { "const": true },
        "acknowledgedAt": { "type": "string", "format": "date-time" }
      }
    },
    "recoveryAcknowledgedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "enrollmentId", "twoFactor", "recoveryDelivery", "twoFactorToken", "tokenExpiresAt", "replayed"],
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "enrollmentId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "twoFactor": { "$ref": "#/$defs/twoFactorEnabledState" },
        "recoveryDelivery": { "$ref": "#/$defs/recoveryDeliveryAcknowledged" },
        "twoFactorToken": { "type": "string", "minLength": 32, "maxLength": 1024, "pattern": "^[A-Za-z0-9_-]+$" },
        "tokenExpiresAt": { "type": "string", "format": "date-time" },
        "replayed": { "type": "boolean" }
      }
    },
    "challengeRequiredError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "requestId", "details"],
      "properties": {
        "code": { "const": "TWO_FACTOR_REQUIRED" },
        "message": { "type": "string", "minLength": 1, "maxLength": 240 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["challengeId", "method", "expiresAt"],
          "properties": {
            "challengeId": { "type": "string", "minLength": 1, "maxLength": 160 },
            "method": { "const": "app" },
            "expiresAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "challengeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["twoFactorToken", "expiresAt"],
      "properties": {
        "twoFactorToken": { "type": "string", "minLength": 32, "maxLength": 1024 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "token": { "type": "string", "minLength": 32, "maxLength": 1024 },
        "user": { "type": "object" }
      }
    },
    "disabledResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["twoFactor"],
      "properties": { "twoFactor": { "$ref": "#/$defs/twoFactorState" } }
    }
  }
}
