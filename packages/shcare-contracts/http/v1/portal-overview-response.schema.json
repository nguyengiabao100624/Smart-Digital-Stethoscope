{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.shcare.vn/http/v1/portal-overview-response.schema.json",
  "title": "Shcare Portal workspace overview response",
  "description": "A workspace-bound, range-scoped overview whose KPI totals are measured by the backend. Clients must not substitute missing values with local zeroes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generatedAt",
    "workspaceId",
    "range",
    "stats",
    "measureData",
    "deviceData",
    "aiJobData"
  ],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "workspaceId": {
      "$ref": "#/$defs/canonicalId"
    },
    "range": {
      "$ref": "#/$defs/range"
    },
    "stats": {
      "$ref": "#/$defs/stats"
    },
    "measureData": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/measurePoint"
      }
    },
    "deviceData": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/devicePoint"
      }
    },
    "aiJobData": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/aiJobPoint"
      }
    }
  },
  "$defs": {
    "canonicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "startAt",
        "endAt",
        "timezoneOffsetMinutes",
        "bucket"
      ],
      "properties": {
        "key": {
          "enum": ["today", "7d", "30d"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "startAt": {
          "type": "string",
          "format": "date-time"
        },
        "endAt": {
          "type": "string",
          "format": "date-time"
        },
        "timezoneOffsetMinutes": {
          "type": "integer",
          "minimum": -720,
          "maximum": 840
        },
        "bucket": {
          "enum": ["4h", "day"]
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clinics",
        "workspaces",
        "patientsCount",
        "pendingDoctors",
        "devicesCount",
        "devicesOnline",
        "scansCount",
        "aiJobsFailed",
        "storageBytes",
        "storageUsed"
      ],
      "properties": {
        "clinics": {
          "type": "integer",
          "minimum": 0
        },
        "workspaces": {
          "type": "integer",
          "minimum": 0
        },
        "patientsCount": {
          "type": "integer",
          "minimum": 0
        },
        "pendingDoctors": {
          "type": "integer",
          "minimum": 0
        },
        "devicesCount": {
          "type": "integer",
          "minimum": 0
        },
        "devicesOnline": {
          "type": "integer",
          "minimum": 0
        },
        "scansCount": {
          "type": "integer",
          "minimum": 0
        },
        "aiJobsFailed": {
          "type": "integer",
          "minimum": 0
        },
        "storageBytes": {
          "type": "number",
          "minimum": 0
        },
        "storageUsed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "measurePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "count"],
      "properties": {
        "time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "day": {
          "type": "string",
          "format": "date"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "devicePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "value", "color"],
      "properties": {
        "key": {
          "enum": ["online", "offline"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "aiJobPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "value", "color"],
      "properties": {
        "key": {
          "enum": ["processing", "completed", "failed", "pending"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    }
  }
}
