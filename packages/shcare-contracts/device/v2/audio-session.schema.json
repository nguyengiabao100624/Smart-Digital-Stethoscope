{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shcare.vn/contracts/device/v2/audio-session.schema.json",
  "title": "Shcare audio session metadata v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocolVersion",
    "frameEncoding",
    "workspaceId",
    "patientId",
    "deviceId",
    "scanId",
    "sessionId",
    "sampleRate",
    "channels",
    "bitsPerSample",
    "encoding",
    "startedAt"
  ],
  "properties": {
    "type": { "const": "audio.session" },
    "protocolVersion": { "const": 2 },
    "frameEncoding": { "const": "shcare_audio_v2" },
    "workspaceId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "patientId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "deviceId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "scanId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "sampleRate": { "const": 16000 },
    "channels": { "const": 1 },
    "bitsPerSample": { "const": 16 },
    "encoding": { "const": "pcm_s16le" },
    "startedAt": { "type": "string", "format": "date-time" }
  }
}
