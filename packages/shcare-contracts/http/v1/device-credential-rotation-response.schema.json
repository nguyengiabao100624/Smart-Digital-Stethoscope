{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shcare.vn/http/v1/device-credential-rotation-response.schema.json",
  "title": "Shcare two-phase device credential rotation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["device", "rotation", "command", "confirmed"],
  "properties": {
    "device": {
      "allOf": [
        { "$ref": "device-operation-common.schema.json#/$defs/publicDevice" },
        { "required": ["credentialRotation"] }
      ]
    },
    "rotation": { "$ref": "device-operation-common.schema.json#/$defs/credentialRotation" },
    "command": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "device-operation-common.schema.json#/$defs/command" },
            { "properties": { "type": { "const": "device.rotate_secret" } } }
          ]
        },
        { "type": "null" }
      ]
    },
    "confirmed": { "type": "boolean" },
    "idempotent": { "const": true }
  },
  "allOf": [
    {
      "if": { "properties": { "confirmed": { "const": true } }, "required": ["confirmed"] },
      "then": {
        "properties": {
          "rotation": {
            "allOf": [
              { "$ref": "device-operation-common.schema.json#/$defs/credentialRotation" },
              { "properties": { "state": { "const": "confirmed" } } }
            ]
          }
        }
      }
    }
  ],
  "x-shcare-success-levels": {
    "accepted": "candidate-generated-and-delivery-attempt-recorded",
    "confirmed": "device-reconnected-with-candidate-and-backend-promoted-it"
  }
}
