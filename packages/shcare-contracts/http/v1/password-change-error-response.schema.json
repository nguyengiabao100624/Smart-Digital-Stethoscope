{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shcare.vn/contracts/http/v1/password-change-error-response.schema.json",
  "title": "Shcare self-service password change error",
  "description": "Standard Shcare error envelope for POST /v1/me/password. It may identify invalid fields but never echoes submitted values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "requestId"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "fieldErrors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  }
}
