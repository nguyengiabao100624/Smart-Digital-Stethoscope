{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shcare.vn/contracts/http/v1/workspace-settings-update-response.schema.json",
  "title": "Workspace settings update receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["ownership", "workspace", "operationId", "replayed"],
  "properties": {
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "workspaceId"],
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "address", "phone", "email", "website", "version", "updatedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "address": { "type": "string", "maxLength": 240 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 160 },
        "website": { "type": "string", "maxLength": 240 },
        "version": { "type": "integer", "minimum": 1 },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "replayed": { "type": "boolean" }
  },
  "x-shcare-confirmation": {
    "ownerFields": ["ownership.userId", "ownership.workspaceId"],
    "versionRule": "workspace.version == request.expectedVersion + 1",
    "fieldRule": "workspace settings fields equal the normalized request",
    "successAuthority": "repository transaction receipt"
  }
}
