{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shcare.vn/http/v1/device-command-request.schema.json",
  "title": "Shcare safe generic device command request",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["restart", "wifi.status", "device.lock"]
    },
    "payload": { "type": "object", "additionalProperties": false },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ttlMs": { "type": "integer", "minimum": 1, "maximum": 600000 }
  },
  "x-shcare-http": {
    "method": "POST",
    "path": "/v1/devices/{deviceId}/commands",
    "requiredHeaders": ["Idempotency-Key"]
  },
  "x-shcare-specialized-command-policy": {
    "forbiddenTypes": ["device.revoke", "device.rotate_secret", "ota.update", "audio.session.start", "audio.session.stop"],
    "failureCode": "DEVICE_COMMAND_SPECIALIZED_ROUTE_REQUIRED"
  },
  "x-shcare-wifi-provisioning-policy": {
    "flow": "esptouch_v2_broadcast",
    "remoteCredentialCommand": "forbidden",
    "failureCode": "DEVICE_WIFI_UPDATE_LOCAL_SETUP_REQUIRED"
  }
}
