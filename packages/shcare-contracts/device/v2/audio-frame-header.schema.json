{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shcare.vn/contracts/device/v2/audio-frame-header.schema.json",
  "title": "Shcare protocol v2 audio frame header",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "frameEncoding",
    "headerLength",
    "payloadLength",
    "scanId",
    "sessionId",
    "sequence",
    "timestampMs",
    "sampleRate",
    "sampleCount",
    "encoding",
    "flags"
  ],
  "properties": {
    "protocolVersion": { "const": 2 },
    "frameEncoding": { "const": "shcare_audio_v2" },
    "headerLength": { "type": "integer", "minimum": 32, "maximum": 310 },
    "payloadLength": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2048,
      "multipleOf": 2
    },
    "scanId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "timestampMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sampleRate": { "const": 16000 },
    "sampleCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "encoding": { "const": "pcm_s16le" },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["start", "end", "discontinuity", "retransmit"] }
    }
  }
}
